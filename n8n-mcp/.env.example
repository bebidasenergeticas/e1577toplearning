# Copia este archivo a .env (nunca subas el .env al repositorio).

# URL de tu instancia de n8n; el sufijo /api/v1 es opcional.
N8N_API_URL=https://n8n.toplearning.org
# API key de n8n: Settings → n8n API → Create an API key.
N8N_API_KEY=

# Opcionales
# N8N_WEBHOOK_URL=https://n8n.toplearning.org   # base de los webhooks si es distinta de la URL de la API
# N8N_MCP_READ_ONLY=true                        # solo herramientas de lectura
# N8N_TIMEOUT_MS=30000
# N8N_MCP_MAX_RESPONSE_CHARS=80000

# Solo para el modo HTTP (conector remoto)
# MCP_TRANSPORT=http
# PORT=3000
# HOST=0.0.0.0
# MCP_AUTH_TOKEN=un-token-largo-y-aleatorio
